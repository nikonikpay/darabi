{"nodes": [{"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design", "label": "Slice 2 Design: Test Engine + CPU Matrix Load", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_testengine", "label": "TestEngine (sequential async queue runner, singleton)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A singleton owning its own CancellationTokenSource, so a queue keeps running across navigation and a new TestCenterViewModel can cancel a run it did not start."}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_itestexecutor", "label": "ITestExecutor", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_repeat_modes", "label": "Repeat Modes (Once / Count / Unlimited)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Failed iteration does not stop the loop, so an intermittent fault a few loops in is still caught."}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_crash_checkpoint", "label": "Crash Checkpoint (test-checkpoint.json)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a crash only incompleteness can be proven, not why; the fact is surfaced but never auto-resumed."}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_testoutcome", "label": "TestOutcome Distinct Outcomes", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancelled, never-run, unsupported and failed must be distinct and never reported as a pass."}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_one_page", "label": "One Test Center Page, Not a Separate Progress Page", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The queue is short, so a second page would only add navigation; splitting later is a small isolated follow-up."}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_cpumatrixstressexecutor", "label": "CpuMatrixStressExecutor (64x64 matrix load with spot checks)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named \"matrix load\", never \"Linpack\": the source spec forbids that label for a simple multiply; any bit-for-bit mismatch is real observed corruption."}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_describemeasuredload", "label": "DescribeMeasuredLoad (measured CPU load evidence)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A speed score alone is not a health pass; returns null rather than a fabricated number when no sample fell in the window."}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_non_goals", "label": "Slice 2 Increment Non-Goals", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_known_gaps", "label": "Deferred and Known Gaps", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_source_spec", "label": "Mazesta Complete Spec (owner's Persian source spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design", "target": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_testengine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-18-mazesta-slice2-test-engine-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design", "target": "docs_superpowers_specs_2026_09_18_mazesta_slice2_test_engine_design_itestexecutor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-18-maz
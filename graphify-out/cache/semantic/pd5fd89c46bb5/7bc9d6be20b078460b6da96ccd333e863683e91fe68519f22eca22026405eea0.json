, "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over a separate sensor-host process and a Windows service; the provider boundary passes plain immutable snapshots so a host process can be introduced later."}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_layer_dependencies", "label": "Allowed Project References", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_core_model", "label": "Core Model (HardwareNode, SensorDefinition, SensorReading, SensorSnapshot)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_sensorrole", "label": "SensorRole", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles let later slices address \"the CPU package temperature\" without string matching."}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_readingvalidator", "label": "ReadingValidator", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A zero temperature is never a healthy reading; LHM returns 0 rather than null for an unreadable energy counter, so zero power would be shown as a real 0.0 W."}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_providerstatus", "label": "ProviderStatus (Ready / Degraded / Failed)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_isensorprovider", "label": "ISensorProvider", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_lhmprovider", "label": "LibreHardwareMonitorProvider", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each IHardware.Update runs in its own try/catch so one failing node only makes its own sensors Stale."}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_sensorrolemap", "label": "SensorRoleMap", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A GPU without a Hot Spot sensor has no GpuHotSpotTemp role; nothing is substituted."}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_pawnio_detection", "label": "PawnIO Driver Detection", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app never modifies Memory Integrity or driver policy; missing PawnIO gives Degraded status and no estimates."}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_wmiinventoryprovider", "label": "WmiInventoryProvider", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_fallback_summary", "label": "Provider Fallback Summary", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_pollingengine", "label": "PollingEngine", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All provider calls happen on one dedicated polling thread; the UI gets latest-wins coalesced snapshots and never blocks on providers."}, {"id": "docs_superpowers_specs_2026_09_12_mazesta_slice1_sensors_monitoring_design_historystore", "label": "HistoryStore (raw and minute ring buffers)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-12-mazesta-slice1-sensors-monitoring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded fixed-capacity tiers; a Missing/Stale/Invalid tick stores NaN so gaps are preserved."}, {"id
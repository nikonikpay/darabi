{"nodes": [{"id": "docs_verification_slice1", "label": "Slice 1 Verification Record", "file_type": "document", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_dev_box", "label": "Slice 1 Dev Box (i9-14900K, RTX 4090, MSI Z790)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_unit_tests", "label": "Non-Hardware Unit Tests (211, then 253 after fix wave)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_hardware_category_tests", "label": "Hardware-Category Tests (elevated)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_silent_uac_elevation", "label": "Silent UAC Auto-Elevation on the Dev Box", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Environment fact, not a defect: a non-elevated sample of the Release binary cannot be produced by launch flags; only the Debug asInvoker build shows NotElevated."}, {"id": "docs_verification_slice1_publish_output", "label": "Publish Output artifacts/Mazesta-Test (ReadyToRun)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_startup_timing", "label": "Startup Timing (window 467 ms, provider 1226 ms, inventory 1658 ms)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_idle_measurement", "label": "Idle Resource Measurement (measure-idle.ps1)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zeros returned by a lost process handle are not a measurement and must not be quoted as one."}, {"id": "docs_verification_slice1_working_set_target", "label": "80 MB Working-Set Target (missed, under review)", "file_type": "rationale", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A WPF process hosting LibreHardwareMonitorLib plus System.Management has a floor well above 80 MB; the v0.5 prototype already measured 207 MiB, so the gap predates this slice. No working-set trimming was applied."}, {"id": "docs_verification_slice1_pawnio_absent_scenario", "label": "PawnIO-Absent / Provider-Failure Scenario", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Degraded(PawnIoMissing) was deduced from source plus measured facts, not from a screenshot of the banner; recorded as partially met."}, {"id": "docs_verification_slice1_network_check", "label": "Network Check (netstat spot samples)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two clean netstat samples are a spot check, not a continuous capture, so the criterion is only partially met."}, {"id": "docs_verification_slice1_chart_gap_evidence", "label": "Three Chart Windows with Visible Pause Gap (regenerated evidence)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The originally cited screenshots showed one window and no gap; evidence was regenerated with real UI Automation Pause/Resume rather than trusting the implementer's claim."}, {"id": "docs_verification_slice1_final_review_fix_wave", "label": "Final-Review Fix Wave (2 Critical, 15 Important findings)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_inventorycache", "label": "InventoryCache (singleton WMI inventory)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DashboardViewModel was transient, so every navigation back re-ran the whole WMI inventory; a singleton cache reads it once per process."}, {"id": "docs_verification_slice1_grid_virtualization", "label": "Monitoring Grid Virtualization (609 to 53 realized rows)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_history_memory_fix", "label": "HistoryStore Lazy Minute Tier and LHM History Off", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 2880-bucket minute tier allocated per sensor up front reserved about 36 MB at 609 sensors; LHM's own per-sensor value history duplicated ours."}, {"id": "docs_verification_slice1_nvme_serial_mismatch", "label": "NVMe Serial Mismatch (WMI NGUID vs LHM vendor serial)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On Windows 11 build 26200 WMI returns the NGUID form while LHM returns the vendor serial, so a serial join cannot work; the join falls back to model name and the test accepts serial or model."}, {"id": "docs_verification_slice1_bidi_value_unit_fix", "label": "Bidi Fix for Value+Unit Runs in Persian UI (C2)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The RTL layout reversed every value+unit run (\"C 53.0\") and mirrored the chart; latin runs are isolated and the plot is not mirrored."}, {"id": "docs_verification_slice1_hascpumsrevidence", "label": "HasCpuMsrEvidence (PawnIO 2.x false banner fix)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LHM's PawnIo.IsInstalled only reads an uninstall registry key and returned false with PawnIO 2.x; live CPU temperature sensors are treated as evidence the driver works."}, {"id": "docs_verification_slice1_acceptance_results", "label": "Slice 1 Acceptance Criteria Results (items 1-10)", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_verification_slice1_deferred_minors", "label": "Known Gaps and Deferred Minors Ledger", "file_type": "concept", "source_file": "docs/VERIFICATION-slice1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_verification_slice1", "target": "docs_verification_slice1_dev_box", "relation": "references", "confidence": "EXTRACT
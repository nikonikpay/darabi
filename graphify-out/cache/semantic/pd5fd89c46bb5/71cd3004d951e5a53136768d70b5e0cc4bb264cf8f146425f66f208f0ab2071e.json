{"nodes": [{"id": "docs_updates", "label": "UPDATES.md (app self-update, site plugin, benchmark lists)", "file_type": "document", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_app_self_update", "label": "App self-update (from 0.7.0)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files replaced in place, Data untouched, previous files kept in Data\\cache\\update\\previous and restored on failure; log in Data\\logs\\update.log."}, {"id": "docs_updates_mazesta_connect_plugin", "label": "Mazesta Connect WordPress plugin", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All app-to-site traffic goes through one plugin under /wp-json/mazesta/v1/; legacy bridge data kept in files (mazesta-connect-data) not WordPress DB since 1.1.0; backup = that folder."}, {"id": "docs_updates_crm_database", "label": "Separate CRM database (mz_* tables)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CRM kept apart from WordPress DB; password encrypted with wp-config keys. HTML reports, benchmark data and stats stay files (large, built once); link via report_id is enough until tens of thousands of reports."}, {"id": "docs_updates_service_number_auto", "label": "Automatic service number R-n", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database lock so two people never get the same number; new computers (2.5.0) use invoice number instead."}, {"id": "docs_updates_warranty_dispatch", "label": "Send to warranty / repair shop", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_news_endpoint", "label": "News endpoint GET /news", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_stock_inventory", "label": "Stock / products (Connect 2.5.0)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock is never entered by hand: purchases minus parts used in builds and jobs, so deleting a wrong invoice or part self-corrects."}, {"id": "docs_updates_purchase_invoice", "label": "Purchase invoice", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_serial_trace", "label": "Serial trace", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_staff_roles", "label": "Staff roles and per-area access", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_staff_api", "label": "Staff API (/staff/...)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_mcp_server", "label": "MCP server for ChatGPT / Claude", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each MCP tool is the staff API under the same person's session: same access and audit log; AI never sees the password; disabling account or changing password cuts the link."}, {"id": "docs_updates_oauth_2_1", "label": "OAuth 2.1 with PKCE and dynamic registration", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_old_crm_import", "label": "Old CRM import (export_old_crm.py, old-crm.jsonl.gz)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stepwise import, idempotent, customers merged by mobile; file holds customer data so never commit it."}, {"id": "docs_updates_sms_gateway", "label": "SMS gateway (Kavenegar, Melipayamak, custom URL)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_system_messages", "label": "Messages to installed systems", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polled every 8h (max 3/day), keyless with random install id, only when anonymous stats is on."}, {"id": "docs_updates_customer_portal", "label": "Customer portal [mazesta_portal]", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown numbers get the same response and no SMS, to avoid revealing who is a customer."}, {"id": "docs_updates_site_key", "label": "Site key (mz_ + 48 hex)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_pairing", "label": "Pairing by site sign-in (pair/start, pair/claim)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App keeps a random secret and sends only its SHA-256; admin confirms the six-letter code; key fetched once."}, {"id": "docs_updates_result_sharing", "label": "Share last result (mazesta_share token page)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_release_key", "label": "Site release key (site-release-key.txt)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_mazestadesk", "label": "MazestaDesk.exe (staff program)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All site calls go through C# (only /staff/ paths, https only); token sealed with DPAPI in Data\\desk.json and never reaches the page."}, {"id": "docs_updates_mazesta_setup", "label": "MazestaTestSetup.exe installer", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "installed.flag makes Data live in %LocalAppData% because Program Files is read-only; runs on built-in .NET Framework so size equals the app zip."}, {"id": "docs_updates_update_json", "label": "update.json signed manifest", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upload update.json and .sig last so a client checking mid-upload never asks for a file not yet there; format numbered (format: 1) so old clients ignore unknown formats."}, {"id": "docs_updates_site_mazesta_folder", "label": "Site /mazesta/ folder", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_signing_key", "label": "Update-signing private key (mazesta-update-private.pem)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If lost, installed copies accept no further updates; keep two backups, never in git or on the site. A hacked site cannot push code because the app verifies signature plus size and SHA-256."}, {"id": "docs_updates_update_key_cs", "label": "UpdateKey.cs (public key)", "file_type": "code", "source_file": "docs/UPDATES.md", "source_location": "L145", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_release_ps1", "label": "tools/release.ps1", "file_type": "code", "source_file": "docs/UPDATES.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_publish_release_ps1", "label": "tools/publish-release.ps1", "file_type": "code", "source_file": "docs/UPDATES.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_publish_ps1", "label": "tools/publish.ps1", "file_type": "code", "source_file": "docs/UPDATES.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_release_notes_format", "label": "Release notes format (+ ~ ! markers)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_two_editions", "label": "Two editions: Mazesta (Admin) and Client", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L174", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Published update is the Client edition, so the Mazesta edition never self-installs it (it would turn into the Client edition)."}, {"id": "docs_updates_benchmark_comparison_lists", "label": "Benchmark comparison lists (benchdb)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L189", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One list per benchmark x workload version x settings; one row per part model (median of each system's best run) so size grows with models not runs; each system counted once; median neutralises outliers."}, {"id": "docs_updates_benchmark_peers", "label": "BenchmarkPeers (Aggregate, WithReferences)", "file_type": "code", "source_file": "docs/UPDATES.md", "source_location": "L250", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_benchmark_records_headlines", "label": "BenchmarkRecords.Headlines version", "file_type": "code", "source_file": "docs/UPDATES.md", "source_location": "L212", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raise the version when a workload changes so incomparable results are never compared."}, {"id": "docs_updates_benchmark_records_effective", "label": "BenchmarkRecords.Effective", "file_type": "code", "source_file": "docs/UPDATES.md", "source_location": "L187", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_reference_result", "label": "Reference result (median of references)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L183", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_bench_archive", "label": "Bench run archive (G:\\Mazesta-BenchArchive)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L204", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_benchmark_runs_jsonl", "label": "Benchmark runs log (Data\\benchmarks\\runs\\*.jsonl, marks.json)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L192", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unreadable values are not recorded (no guessing); GPU core count omitted as no reliable Windows source."}, {"id": "docs_updates_overclock_flag", "label": "Overclock flag (separate list row)", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L222", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_featured_results", "label": "Featured (starred) results", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": "L224", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_benchmark_mode", "label": "Benchmark mode (reduced sensor polling)", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": "L232", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While a benchmark runs: no live page data or animations, only CPU/GPU/RAM plus overlay sensors read, tray checks and update checks postponed, to avoid disturbing the measurement."}, {"id": "docs_updates_benchmark_privacy", "label": "Benchmark privacy (no computer name in lists)", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_persistence_updates", "label": "src/Mazesta.Persistence/Updat
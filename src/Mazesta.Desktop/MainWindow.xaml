<Window x:Class="Mazesta.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mazesta.Desktop"
        xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
        xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
        xmlns:views="clr-namespace:Mazesta.Desktop.Views"
        xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
        mc:Ignorable="d"
        Title="{loc:Loc App_Title}"
        MinWidth="960" MinHeight="600"
        Width="1280" Height="800"
        Icon="pack://application:,,,/Assets/mazesta.ico"
        Background="{StaticResource Brush.Background}">
    <Window.Resources>
        <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Padding" Value="0,8,0,8" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <!-- The selected page: a yellow-tinted pill with a yellow bar on the reading-start side and yellow text. -->
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" Background="{StaticResource Brush.Accent}" HorizontalAlignment="Left" Margin="-12,2,0,2" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentDim}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PauseButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="{loc:Loc Status_Pause}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Content" Value="{loc:Loc Status_Resume}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BannerBorderStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Banner}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- Spec 9.4: Ctrl+1 ... Ctrl+0 open the first ten pages. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="6" />
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="7" />
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="8" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding NavigateCommand}" CommandParameter="9" />
    </Window.InputBindings>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <!-- Disabled until the provider has settled: a click during the hardware scan would build a
             page against an empty hardware list (spec: pages read engine.Hardware once at
             construction) and that page would never pick up the real sensors. -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
        <DockPanel>
            <!-- The brand: the round logo and the wordmark, always left-to-right like the logo itself. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,14" FlowDirection="LeftToRight" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/mazesta-logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <controls:LogoMark Height="15" HorizontalAlignment="Left" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="TEST SUITE" FontFamily="{StaticResource App.Font.Latin}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" Margin="1,4,0,0" />
                </StackPanel>
            </StackPanel>
            <!-- The service job (spec 7.1): typed once, printed on every report made while it is set. -->
            <Border DockPanel.Dock="Bottom" Margin="12,6,12,12" Padding="10,8" CornerRadius="10" Background="{StaticResource Brush.Inset}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Service_Number}" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding ServiceNumber, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Value}" MaxLength="40" />
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Border}" Margin="16,0,16,6" />
        <ListBox
                  Style="{StaticResource SidebarListBoxStyle}"
                  ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                  ItemsSource="{Binding Items}"
                  IsEnabled="{Binding IsNavigationEnabled}"
                  SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NavItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        <TextBlock Text="{Binding Label}" TextTrimming="None" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </DockPanel>
        </Border>

        <!-- Content area: banner + page -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource BannerBorderStyle}"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                    <Button Content="{Binding BannerLinkText}" Command="{Binding OpenBannerLinkCommand}"
                            Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerLinkUrl}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Text="{loc:Loc Nav_Starting}" Foreground="{StaticResource Brush.TextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                        <views:PlaceholderView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
                        <views:MonitoringView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TestCenterViewModel}">
                        <views:TestCenterView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <views:ReportsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:BenchmarksViewModel}">
                        <views:BenchmarksView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
                        <views:ComponentView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:WindowsToolsViewModel}">
                        <views:WindowsToolsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:GamingViewModel}">
                        <views:GamingView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TuningViewModel}">
                        <views:TuningView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
                        <views:SystemInfoView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- Notices (spec 9.4): above the page, in the bottom corner; a click dismisses one. -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16" MaxWidth="380">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                        <Button Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                Margin="0,8,0,0" Padding="0" HorizontalContentAlignment="Stretch" Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="5" CornerRadius="5,0,0,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Background" Value="{StaticResource Brush.Success}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Danger"><Setter Property="Background" Value="{StaticResource Brush.Danger}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Background" Value="{StaticResource Brush.Warning}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="12,10" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ProviderStatusText}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <controls:HelpTip HelpKey="Status_Provider" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding IntervalText}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Grid.Column="3" Command="{Binding TogglePauseCommand}" Style="{StaticResource PauseButtonStyle}" Padding="8,2" />
            </Grid>
        </Border>
    </Grid>
</Window>

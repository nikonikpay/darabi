<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One line icon per sensor kind on a 24x24 grid (stroked, round caps), coloured by the kind's
         own brush so a column of readings can be scanned by colour as well as by name. Looked up by
         SensorKindToIconConverter / SensorKindToBrushConverter as "Icon.<Kind>" / "Brush.Kind.<Kind>";
         a kind without an entry falls back to Icon.Default. -->
    <Geometry x:Key="Icon.Default">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,12 L16,8</Geometry>
    <Geometry x:Key="Icon.Temperature">M14,14.76 V3.5 A2.5,2.5 0 0 0 9,3.5 V14.76 A4.5,4.5 0 1 0 14,14.76 Z</Geometry>
    <Geometry x:Key="Icon.Voltage">M13,2 L3,14 H12 L11,22 L21,10 H12 Z</Geometry>
    <Geometry x:Key="Icon.Current">M4,12 H19 M13,6 L19,12 L13,18</Geometry>
    <Geometry x:Key="Icon.Power">M18.36,6.64 A9,9 0 1 1 5.64,6.64 M12,2 V12</Geometry>
    <Geometry x:Key="Icon.Clock">M2,12 H6 L9,3 L15,21 L18,12 H22</Geometry>
    <Geometry x:Key="Icon.Load">M18,20 V10 M12,20 V4 M6,20 V14</Geometry>
    <Geometry x:Key="Icon.Fan">M9.59,4.59 A2,2 0 1 1 11,8 H2 M12.59,19.41 A2,2 0 1 0 14,16 H2 M17.73,7.73 A2.5,2.5 0 1 1 19.5,12 H2</Geometry>
    <Geometry x:Key="Icon.Control">M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23</Geometry>
    <Geometry x:Key="Icon.Data">M21,5 A9,3 0 1 1 3,5 A9,3 0 1 1 21,5 Z M21,12 C21,13.66 17,15 12,15 S3,13.66 3,12 M3,5 V19 C3,20.66 7,22 12,22 S21,20.66 21,19 V5</Geometry>
    <Geometry x:Key="Icon.Throughput">M7,17 V5 M3,9 L7,5 L11,9 M17,7 V19 M13,15 L17,19 L21,15</Geometry>
    <Geometry x:Key="Icon.Timespan">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,6 V12 L16,14</Geometry>

    <SolidColorBrush x:Key="Brush.Kind.Temperature" Color="#FF6B57" />
    <SolidColorBrush x:Key="Brush.Kind.Voltage" Color="#FFCB3D" />
    <SolidColorBrush x:Key="Brush.Kind.Current" Color="#FFB020" />
    <SolidColorBrush x:Key="Brush.Kind.Power" Color="#FF9F43" />
    <SolidColorBrush x:Key="Brush.Kind.Clock" Color="#4FC3F7" />
    <SolidColorBrush x:Key="Brush.Kind.Load" Color="#7C9CFF" />
    <SolidColorBrush x:Key="Brush.Kind.Fan" Color="#3DD6C6" />
    <SolidColorBrush x:Key="Brush.Kind.Control" Color="#9AA7BD" />
    <SolidColorBrush x:Key="Brush.Kind.Data" Color="#B78CFF" />
    <SolidColorBrush x:Key="Brush.Kind.Throughput" Color="#4ADE80" />
    <SolidColorBrush x:Key="Brush.Kind.Default" Color="#9AA7BD" />
</ResourceDictionary>

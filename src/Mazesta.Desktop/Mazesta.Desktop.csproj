<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app layer under the web edition (Mazesta.Web): composition, the page view models the web bridge drives, the services (reports and
       PDF printing, the overlay), the string tables, and the one WPF window still drawn natively, the on-screen overlay. It was the WPF
       edition's own app until that edition was retired (tag wpf-edition-final); it is a library now. The assembly keeps its old name so the
       overlay's pack URIs and the resource names stay as they were. The fonts and the icon here are linked into the web edition's exe. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MazestaTest</AssemblyName>
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mazesta.Core/Mazesta.Core.csproj" />
    <ProjectReference Include="../Mazesta.Diagnostics/Mazesta.Diagnostics.csproj" />
    <ProjectReference Include="../Mazesta.Diagnostics.Gpu/Mazesta.Diagnostics.Gpu.csproj" />
    <ProjectReference Include="../Mazesta.Hardware/Mazesta.Hardware.csproj" />
    <ProjectReference Include="../Mazesta.Monitoring/Mazesta.Monitoring.csproj" />
    <ProjectReference Include="../Mazesta.Persistence/Mazesta.Persistence.csproj" />
    <ProjectReference Include="../Mazesta.Reporting/Mazesta.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fonts\*.ttf;Assets\*" />
    <EmbeddedResource Update="Localization\*.resx" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mazesta.Desktop.Tests" />
    <InternalsVisibleTo Include="MazestaWeb" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MazestaTest</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <ApplicationIcon></ApplicationIcon>
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mazesta.Core/Mazesta.Core.csproj" />
    <ProjectReference Include="../Mazesta.Diagnostics/Mazesta.Diagnostics.csproj" />
    <ProjectReference Include="../Mazesta.Diagnostics.Gpu/Mazesta.Diagnostics.Gpu.csproj" />
    <ProjectReference Include="../Mazesta.Hardware/Mazesta.Hardware.csproj" />
    <ProjectReference Include="../Mazesta.Monitoring/Mazesta.Monitoring.csproj" />
    <ProjectReference Include="../Mazesta.Persistence/Mazesta.Persistence.csproj" />
    <ProjectReference Include="../Mazesta.Reporting/Mazesta.Reporting.csproj" />
    <!-- Built first and shipped next to the app (see BundleTray): Settings starts, stops and registers it. Not referenced as code. -->
    <ProjectReference Include="../Mazesta.Tray/Mazesta.Tray.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\*.jpg" />
    <EmbeddedResource Update="Localization\*.resx" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mazesta.Desktop.Tests" />
  </ItemGroup>
  <Target Name="BundleTray" AfterTargets="Build">
    <PropertyGroup><TrayDir>$(MSBuildThisFileDirectory)../Mazesta.Tray/bin/$(Configuration)/$(TargetFramework)/</TrayDir></PropertyGroup>
    <ItemGroup><TrayFile Include="$(TrayDir)MazestaTray.exe;$(TrayDir)MazestaTray.dll;$(TrayDir)MazestaTray.runtimeconfig.json;$(TrayDir)MazestaTray.deps.json" /></ItemGroup>
    <Copy SourceFiles="@(TrayFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- The SDK already publishes the tray's apphost, deps and runtimeconfig for a project reference; only its dll is missing. -->
  <Target Name="PublishTrayDll" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="BundleTray">
    <ItemGroup><ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)../Mazesta.Tray/bin/$(Configuration)/$(TargetFramework)/MazestaTray.dll" RelativePath="MazestaTray.dll" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  </Target>
</Project>

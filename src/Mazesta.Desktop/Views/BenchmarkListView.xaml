<!-- The benchmark rows (tick for the queue, duration, options, Run, progress, numbers) and the queue bar, shared by the Benchmarks page and the
     component pages. Its own UserControl so the rows' commands find this control's view model (a BenchmarksViewModel) as their ancestor. -->
<UserControl x:Class="Mazesta.Desktop.Views.BenchmarkListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Mazesta.Desktop.Controls">
    <StackPanel>
        <!-- The queue: tick rows, then run them one after another. -->
        <Border Style="{StaticResource Card}" Padding="14,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Success}" Content="{loc:Loc Bench_RunSelected}" Command="{Binding RunSelectedCommand}" Padding="16,7" />
                    <Button Style="{StaticResource Button.Danger}" Content="{loc:Loc Bench_Cancel}" Command="{Binding CancelCommand}" Padding="16,7" Margin="8,0,0,0" />
                    <Button Content="{loc:Loc Test_SelectAll}" Command="{Binding SelectAllCommand}" Margin="16,0,0,0" />
                    <Button Content="{loc:Loc Test_ClearSelection}" Command="{Binding ClearSelectionCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Visibility="{Binding QueueText, Converter={x:Static controls:NonEmptyToVisibility.Instance}}">
                    <TextBlock Text="{Binding QueueText}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                </Border>
            </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BenchmarkRowViewModel}">
                    <Border CornerRadius="14" Padding="16,14" Margin="0,0,0,12" BorderThickness="1" Background="{StaticResource Brush.Surface}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{loc:Loc Bench_SelectHint}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold" FontSize="14.5" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.Outline}" DockPanel.Dock="Right" Content="{loc:Loc Bench_Run}"
                                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Text="{loc:Loc Test_Seconds}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="6,0,14,0" />
                                <TextBox DockPanel.Dock="Right" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Width="62" Style="{StaticResource TextBox.Value}" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{loc:Loc Bench_Duration}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}" Margin="30,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TestOptionViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="0,10,18,0">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label" MinWidth="200" VerticalAlignment="Center"
                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinWidth="110" Style="{StaticResource TextBox.Value}" VerticalAlignment="Center"
                                                     Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="30,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <ProgressBar Value="{Binding PercentComplete}" Maximum="100" Height="6" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- One tile per number: the value large, what it measures small underneath, so a row of results reads at a glance. -->
                            <ItemsControl ItemsSource="{Binding Metrics}" Margin="30,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MetricRow}">
                                        <Border Style="{StaticResource Well}" Margin="0,0,10,10" MinWidth="150">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.BigValue}" FontSize="20" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="210" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Value}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="30,2,0,0" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

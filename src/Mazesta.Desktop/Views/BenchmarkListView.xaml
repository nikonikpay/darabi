<!-- The benchmark rows (duration, options, Run/Cancel, progress, numbers), shared by the Benchmarks page and the component pages.
     Its own UserControl so the rows' commands find this control's view model (a BenchmarksViewModel) as their ancestor. -->
<UserControl x:Class="Mazesta.Desktop.Views.BenchmarkListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels">
    <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:BenchmarkRowViewModel}">
                <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Danger}" DockPanel.Dock="Right" Content="{loc:Loc Bench_Cancel}" Padding="12,5" Margin="6,0,0,0"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Style="{StaticResource Button.Success}" DockPanel.Dock="Right" Content="{loc:Loc Bench_Run}" Padding="12,5"
                                    Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <TextBox DockPanel.Dock="Right" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Width="60" Style="{StaticResource TextBox.Value}" Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{loc:Loc Bench_Duration}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TestOptionViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="0,8,18,0">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label" MinWidth="200" VerticalAlignment="Center"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinWidth="110" Style="{StaticResource TextBox.Value}" VerticalAlignment="Center"
                                                 Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ProgressBar Value="{Binding PercentComplete}" Maximum="100" Height="6" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <!-- One tile per number: the value large, what it measures small underneath, so a row of results reads at a glance. -->
                        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MetricRow}">
                                    <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="6" Padding="12,8" Margin="0,0,8,8" MinWidth="150">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Value}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="210" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Value}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

<UserControl x:Class="Mazesta.Desktop.Views.WindowsToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:local="clr-namespace:Mazesta.Desktop.Views"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{loc:Loc Nav_WindowsTools}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{loc:Loc Tools_Note}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- Repair tools: one at a time, with their own output. -->
        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,12,10">
            <StackPanel>
                <TextBlock Text="{loc:Loc Tools_Repair}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <WrapPanel>
                    <Button Style="{StaticResource Button.Success}" Content="{loc:Loc Tools_Sfc}" Command="{Binding SfcCommand}" Padding="12,6" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Success}" Content="{loc:Loc Tools_DismScan}" Command="{Binding DismScanCommand}" Padding="12,6" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Primary}" Content="{loc:Loc Tools_DismRestore}" Command="{Binding DismRestoreCommand}" Padding="12,6" Margin="0,0,8,8" />
                    <Button Style="{StaticResource Button.Danger}" Content="{loc:Loc Bench_Cancel}" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,8" />
                </WrapPanel>
                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Windows' own windows for the settings this page does not change itself. -->
        <Border Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{loc:Loc Tools_Windows}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <Button Content="{loc:Loc Tools_DiskCleanup}" Command="{Binding DiskCleanupCommand}" HorizontalAlignment="Stretch" Padding="12,6" Margin="0,0,0,8" />
                <Button Content="{loc:Loc Tools_WindowsUpdate}" Command="{Binding WindowsUpdateCommand}" HorizontalAlignment="Stretch" Padding="12,6" Margin="0,0,0,8" />
                <Button Content="{loc:Loc Tools_PageFileSettings}" Command="{Binding PageFileSettingsCommand}" HorizontalAlignment="Stretch" Padding="12,6" Margin="0,0,0,12" />
                <TextBlock Text="{loc:Loc Tools_PageFile}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding PageFile}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" />
                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Value}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The tool's output, console-style (spec 9.4 log viewer). -->
        <Border Grid.Row="3" Grid.Column="0" Background="#FF0E1014" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
            <ListBox ItemsSource="{Binding Output}" Background="Transparent" BorderThickness="0" Padding="8" FlowDirection="LeftToRight"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" local:AutoScroll.ToEnd="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#FFB9C3D1" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>

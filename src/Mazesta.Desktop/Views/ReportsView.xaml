<UserControl x:Class="Mazesta.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Nav_Reports}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Text="{loc:Loc Reports_Empty}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" VerticalAlignment="Top"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportRowViewModel}">
                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="10" Padding="10,1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#33E0A030" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="Passed"><Setter Property="Background" Value="#334CAF50" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="Failed"><Setter Property="Background" Value="#33E5534B" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{loc:Loc Reports_Html}" Padding="12,5" Margin="6,0,0,0"
                                            Command="{Binding DataContext.OpenHtmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{loc:Loc Reports_Pdf}" Padding="12,5" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{loc:Loc Reports_Json}" Padding="12,5" Margin="6,0,0,0"
                                            Command="{Binding DataContext.OpenJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{loc:Loc Reports_Folder}" Padding="12,5" Margin="6,0,0,0"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{loc:Loc Reports_Delete}" Padding="12,5" Margin="6,0,0,0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>

<UserControl x:Class="Mazesta.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
             mc:Ignorable="d"
             Background="{StaticResource Brush.Background}">
    <UserControl.Resources>
        <controls:InventoryFieldConverter x:Key="InventoryField" />
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Width" Value="270" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Implicit template: any SensorCardViewModel (Cpu/HotSpot/Ram/each Gpus item) renders as a card
             with a 3 px top stripe in the card's Accent colour. -->
        <DataTemplate DataType="{x:Type vm:SensorCardViewModel}">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{Binding Accent}" CornerRadius="8,8,0,0" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,10,12,4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource Text.Value}" />
                        <controls:HelpTip HelpKey="{Binding HelpKey}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Lines}" Margin="12,0,12,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CardLine}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource Brush.TextMuted}" Style="{StaticResource Text.Value}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="12,0,0,0" Style="{StaticResource Text.Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- WrapPanel does not reliably receive a finite width from ScrollViewer's measure pass even
         with HorizontalScrollBarVisibility="Disabled", so its width is bound explicitly to the
         ScrollViewer's viewport to force wrapping instead of an endless single row. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <WrapPanel Margin="8" Orientation="Horizontal"
                   Width="{Binding ActualWidth, ElementName=Scroller}">
            <ContentControl Content="{Binding Cpu}" />
            <ContentControl Content="{Binding HotSpot}" />
            <ItemsControl ItemsSource="{Binding Gpus}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl Content="{Binding Ram}" />

            <!-- Inventory card -->
            <Border Style="{StaticResource CardBorderStyle}" Width="300">
                <StackPanel Margin="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Dashboard_Inventory}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <controls:HelpTip HelpKey="Dashboard_Inventory" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Inventory}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Converter={StaticResource InventoryField}}" Foreground="{StaticResource Brush.TextMuted}" Style="{StaticResource Text.Value}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource InventoryField}, ConverterParameter=Value}" TextWrapping="Wrap" Style="{StaticResource Text.Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding InventoryStatus}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InventoryStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Mazesta / AM9 offline card -->
            <Border Style="{StaticResource CardBorderStyle}" Width="360">
                <StackPanel Margin="14,12">
                    <TextBlock Text="{loc:Loc Dashboard_Mazesta_Title}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding ShopName}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,8" />
                    <TextBlock Text="{loc:Loc Dashboard_Mazesta_L1}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Dashboard_Mazesta_L2}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Dashboard_Mazesta_Site}" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SiteUrl}" />
                        <Button Content="{loc:Loc Dashboard_Mazesta_Contact}" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ContactUrl}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Phones}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,10" Style="{StaticResource Text.Value}" />

                    <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/am9.jpg" MaxHeight="120" Stretch="Uniform" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProductDescription}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,8" TextWrapping="Wrap" Style="{StaticResource Text.Value}" />
                            <Button Content="{loc:Loc Dashboard_Product_View}" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ProductUrl}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </WrapPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Mazesta.Desktop.Views.BenchmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:local="clr-namespace:Mazesta.Desktop.Views"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="1180">
            <TextBlock Text="{loc:Loc Nav_Benchmarks}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{loc:Loc Bench_Note}" Style="{StaticResource Text.PageSubtitle}" />
            <local:BenchmarkListView />
        </StackPanel>
    </ScrollViewer>
</UserControl>

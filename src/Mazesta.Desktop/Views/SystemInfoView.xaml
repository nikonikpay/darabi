<UserControl x:Class="Mazesta.Desktop.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:local="clr-namespace:Mazesta.Desktop.Views"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Nav_SystemInfo}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <local:InfoSectionsView DataContext="{Binding Sections}" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>

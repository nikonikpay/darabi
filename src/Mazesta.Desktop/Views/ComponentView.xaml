<UserControl x:Class="Mazesta.Desktop.Views.ComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:local="clr-namespace:Mazesta.Desktop.Views"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <Grid Margin="20,20,20,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Note}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- Left: what the part is, and how fast it is. -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <local:InfoSectionsView DataContext="{Binding Inventory}" />
                <TextBlock Text="{loc:Loc Nav_Benchmarks}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,8"
                           Visibility="{Binding HasBenchmarks, Converter={StaticResource BoolToVis}}" />
                <local:BenchmarkListView DataContext="{Binding Benchmarks}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Right: its live sensors, the Monitoring tree limited to this part. -->
        <Border Grid.Row="2" Grid.Column="1" Visibility="{Binding HasSensors, Converter={StaticResource BoolToVis}}">
            <local:MonitoringView DataContext="{Binding Sensors}" />
        </Border>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc Component_NoSensors}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="12,0,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSensors}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>

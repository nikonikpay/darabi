<UserControl x:Class="Mazesta.Desktop.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
             xmlns:hw="clr-namespace:Mazesta.Core.Hardware;assembly=Mazesta.Core"
             mc:Ignorable="d"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <UserControl.Resources>
        <!-- Value cell: latin text (a number with its unit attached), right-aligned so a column of
             readings lines up. The container's Foreground cannot grey a non-Ok row on its own - the
             theme's implicit TextBlock style sets Foreground explicitly - so the quality is driven per
             cell here. -->
        <Style x:Key="CellStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Static hw:DataQuality.Missing}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Static hw:DataQuality.Stale}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Static hw:DataQuality.Invalid}">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <!-- Last, so it wins: dark text reads on the light accent used for selection. -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Background}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NumberCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="RowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding State}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Level 1: one card per hardware node. -->
        <ControlTemplate x:Key="NodeGroupTemplate" TargetType="GroupItem">
            <Expander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}"
                      Background="{StaticResource Brush.Surface}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1"
                      Margin="0,0,0,8">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Name.Kind}" Value="{x:Static hw:HardwareKind.Cpu}">
                                            <Setter Property="Background" Value="{StaticResource Brush.Series.Cpu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name.Kind}" Value="{x:Static hw:HardwareKind.Gpu}">
                                            <Setter Property="Background" Value="{StaticResource Brush.Series.Gpu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name.Kind}" Value="{x:Static hw:HardwareKind.Memory}">
                                            <Setter Property="Background" Value="{StaticResource Brush.Series.Memory}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name.Kind}" Value="{x:Static hw:HardwareKind.Storage}">
                                            <Setter Property="Background" Value="{StaticResource Brush.Series.Storage}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name.Kind}" Value="{x:Static hw:HardwareKind.Motherboard}">
                                            <Setter Property="Background" Value="{StaticResource Brush.Series.Motherboard}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name.Kind}" Value="{x:Static hw:HardwareKind.Network}">
                                            <Setter Property="Background" Value="{StaticResource Brush.Series.Network}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- Node names are hardware model names: always latin. -->
                        <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource Text.Value}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsPresenter />
            </Expander>
        </ControlTemplate>

        <!-- Level 2: a titled, collapsible section ("Core Clocks") inside the node... -->
        <ControlTemplate x:Key="SectionGroupTemplate" TargetType="GroupItem">
            <Expander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}" Margin="6,2,0,2" BorderThickness="0" Background="Transparent">
                <Expander.Header>
                    <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                </Expander.Header>
                <ItemsPresenter />
            </Expander>
        </ControlTemplate>
        <!-- ...or, for a sensor with nothing to be grouped with, no header at all. -->
        <ControlTemplate x:Key="FlatSectionTemplate" TargetType="GroupItem">
            <ItemsPresenter />
        </ControlTemplate>
        <Style x:Key="SectionContainerStyle" TargetType="GroupItem">
            <Setter Property="Template" Value="{StaticResource SectionGroupTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name.IsFlat}" Value="True">
                    <Setter Property="Template" Value="{StaticResource FlatSectionTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NodeContainerStyle" TargetType="GroupItem">
            <Setter Property="Template" Value="{StaticResource NodeGroupTemplate}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="12,10,12,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Grid Width="220" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Placeholder: WPF has no native one, so the prompt sits behind the (transparent
                         when empty) text and disappears as soon as anything is typed. -->
                    <TextBlock Text="{loc:Loc Monitoring_Search}" Foreground="{StaticResource Brush.TextMuted}"
                               Margin="8,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <controls:HelpTip HelpKey="Monitoring_Search" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{loc:Loc Monitoring_ResetStats}" Command="{Binding ResetStatsCommand}"
                        VerticalAlignment="Center" Margin="8,0,0,0" />
                <controls:HelpTip HelpKey="Monitoring_ResetStats" VerticalAlignment="Center" />
                <Button VerticalAlignment="Center" Command="{Binding TogglePauseCommand}" Margin="12,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="{loc:Loc Status_Pause}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="{loc:Loc Status_Resume}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <controls:HelpTip HelpKey="Monitoring_Pause" VerticalAlignment="Center" />
                <ComboBox Width="70" VerticalAlignment="Center" Margin="12,0,0,0" FlowDirection="LeftToRight"
                          ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedIntervalSeconds}" />
                <controls:HelpTip HelpKey="Monitoring_Interval" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- The whole sensor tree: ONE virtualizing ListView, grouped by node and then by section,
             rather than one ListView per group inside a page-wide ScrollViewer: nested lists were
             measured with infinite height, so their VirtualizingStackPanels realised every row of every
             group. Here the panel virtualizes the group items too (IsVirtualizingWhenGrouping), so only
             the rows actually on screen exist. Node expansion is bound two-way to
             HardwareGroupViewModel.IsExpanded, which is the user's, persisted in config and never
             touched by a tick. -->
        <ListView Grid.Row="1" Margin="12,0,12,12"
                  ItemsSource="{Binding RowsView}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ItemContainerStyle="{StaticResource RowContainerStyle}"
                  MouseDoubleClick="Rows_MouseDoubleClick"
                  KeyDown="Rows_KeyDown">
            <ListView.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource NodeContainerStyle}" />
                <GroupStyle ContainerStyle="{StaticResource SectionContainerStyle}" />
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="300" Header="{loc:Loc Column_Sensor}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:SensorRowViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Kind, Converter={StaticResource KindToIcon}}"
                                          Stroke="{Binding Kind, Converter={StaticResource KindToBrush}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="140">
                        <GridViewColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Column_Current}" />
                                    <controls:HelpTip HelpKey="Column_Current" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.HeaderTemplate>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Current}" Style="{StaticResource NumberCellStyle}" FontWeight="SemiBold" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="120">
                        <GridViewColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Column_Min}" />
                                    <controls:HelpTip HelpKey="Column_MinMaxAvg" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.HeaderTemplate>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Min}" Style="{StaticResource NumberCellStyle}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="120" Header="{loc:Loc Column_Max}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Max}" Style="{StaticResource NumberCellStyle}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="120" Header="{loc:Loc Column_Avg}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Avg}" Style="{StaticResource NumberCellStyle}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>

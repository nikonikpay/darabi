<UserControl x:Class="Mazesta.Desktop.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Nav_Gaming}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="{loc:Loc Gaming_Note}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Gaming_PowerPlan}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Plans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PowerPlanRow}">
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource Text.Value}" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Left" Background="{StaticResource Brush.Success}" CornerRadius="10" Padding="10,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc Gaming_Active}" Foreground="White" FontSize="12" />
                                    </Border>
                                    <Button DockPanel.Dock="Right" Content="{loc:Loc Gaming_Activate}" Padding="12,4"
                                            Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Loc Gaming_GameMode}" Foreground="{StaticResource Brush.TextMuted}" Width="260" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding GameMode}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="{loc:Loc Gaming_OpenSettings}" Command="{Binding OpenGameModeCommand}" Padding="12,4" />
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Loc Gaming_Hags}" Foreground="{StaticResource Brush.TextMuted}" Width="260" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding GpuScheduling}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="{loc:Loc Gaming_OpenSettings}" Command="{Binding OpenGraphicsCommand}" Padding="12,4" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

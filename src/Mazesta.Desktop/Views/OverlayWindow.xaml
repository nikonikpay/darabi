<!-- The on-screen overlay: a small translucent plate in a corner of the screen, always on top, that the mouse passes through (see the code-behind).
     On top, the frame-rate block: the rate big, 1 % low and frame time beside it, and the last minute as a trace on a scope screen with the 1 % low
     as a dashed level. Under it a block per part, divided by hairlines, under its channel key (a solid tag in the part's colour, as a scope marks
     its channels): each reading's number white with its unit small in the hue, and a thin scale for a share of a fixed top (load, temperature);
     a charted item draws its last minute instead, with the chart's top written on it. Numbers are set in Bahnschrift, the DIN face Windows ships. -->
<Window x:Class="Mazesta.Desktop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
        xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
        xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
        Title="Mazesta Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Focusable="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="Ov.Font">Bahnschrift SemiCondensed, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Ov.FontWide">Bahnschrift, Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="Ov.Label" Color="#FFA4A8AD" />
        <SolidColorBrush x:Key="Ov.Faint" Color="#FF737A82" />
        <SolidColorBrush x:Key="Ov.Line" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="Ov.Game" Color="#FFFDD400" />
        <Style x:Key="Ov.Num" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ov.Font}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="Ov.Tag" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ov.FontWide}" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ov.Faint}" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="8" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="12,9,12,10">
        <Border.Background><SolidColorBrush Color="#0E1012" Opacity="{Binding Opacity}" /></Border.Background>
        <StackPanel Width="{Binding PanelWidth}">
            <StackPanel.LayoutTransform><ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" /></StackPanel.LayoutTransform>

            <!-- The mark, and the program the frame rate is measured in. -->
            <DockPanel Margin="0,0,0,8">
                <Border DockPanel.Dock="Left" Width="3" Height="10" Background="{StaticResource Ov.Game}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="MAZESTA" Style="{StaticResource Ov.Tag}" Foreground="#FF8A9097" VerticalAlignment="Center" />
                <TextBlock Text="{Binding HeroApp}" FontFamily="{StaticResource Ov.Font}" FontSize="10" Foreground="{StaticResource Ov.Faint}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" FlowDirection="LeftToRight" />
            </DockPanel>

            <!-- The frame-rate block. -->
            <StackPanel Margin="0,0,0,10" Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" DataContext="{Binding HeroFps}"
                                Visibility="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}">
                        <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="44" FontWeight="SemiBold" LineHeight="40" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="FPS" Style="{StaticResource Ov.Tag}" FontSize="9.5" Foreground="{StaticResource Ov.Game}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding HeroLow}" Visibility="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}">
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="1% LOW" Style="{StaticResource Ov.Tag}" Width="38" Margin="5,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding HeroFrameTime}" Visibility="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}">
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="MS" Style="{StaticResource Ov.Tag}" Width="38" Margin="5,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <controls:FrameChart Values="{Binding HeroTrend}" Level="{Binding HeroLowValue}" Stroke="{StaticResource Ov.Game}" Capacity="{x:Static vm:OverlayViewModel.TrendLength}"
                                     Height="72" Margin="0,8,0,0" Visibility="{Binding HeroFps, Converter={x:Static controls:NullToCollapsed.Instance}}" />
            </StackPanel>

            <!-- A block per part; they wrap at the panel's width: one per line, or two side by side. -->
            <ItemsControl ItemsSource="{Binding Blocks}" Margin="-4,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlaySection}">
                        <Border Width="{Binding DataContext.SectionWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="4,0"
                                BorderBrush="{StaticResource Ov.Line}" BorderThickness="0,1,0,0" Padding="0,8,0,7">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Border DockPanel.Dock="Left" Background="{Binding Hue}" CornerRadius="2" Padding="5,2,5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Ov.Tag}" Foreground="#FF111111" />
                                    </Border>
                                    <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource Ov.Font}" FontSize="9.5" Foreground="{StaticResource Ov.Faint}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" FlowDirection="LeftToRight" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:OverlayRow}">
                                            <StackPanel Margin="0,3,0,2">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource Ov.Label}" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding UnitText}" Style="{StaticResource Ov.Num}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding Hue}" Margin="3,0,0,2" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <!-- A share of a fixed top: a thin scale that fills from the start edge. -->
                                                <Grid Height="2" Margin="0,4,0,0" FlowDirection="LeftToRight" Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}">
                                                    <Border Background="#1AFFFFFF" />
                                                    <Border Background="{Binding Hue}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}" /></Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <Border Height="26" Margin="0,4,0,1" Background="#4D000000" CornerRadius="2" Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <controls:Sparkline Values="{Binding Trend}" Maximum="{Binding TrendMax}" Capacity="{x:Static vm:OverlayViewModel.TrendLength}" Stroke="{Binding Hue}" />
                                                        <StackPanel Orientation="Horizontal" Margin="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" TextElement.FontSize="8" TextElement.Foreground="#AAFFFFFF">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding TrendMaxValue}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Loc Overlay_ChartMaxWord}" Margin="0,0,3,0" />
                                                            <TextBlock Text="{Binding TrendMaxValue}" FontFamily="{StaticResource Ov.Font}" FlowDirection="LeftToRight" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>

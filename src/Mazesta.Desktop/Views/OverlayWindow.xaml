<!-- The on-screen overlay: a small translucent plate in a corner of the screen, always on top, that the mouse passes through (see the code-behind).
     Stacked (one column or two): on top the frame-rate box - the rate big, 1 % low and frame time beside it, the session's average, lowest and
     highest under it, and the last minute as a trace on a scope screen with the 1 % low as a dashed level - then a box per part in the part's
     colour (edge and a faint wash), its title bold on a solid tag: each reading's label, its number white with the unit small in the hue, and a
     thin scale for a share of a fixed top; a charted item draws its last minute instead. As a line: the same boxes side by side in one strip
     along the screen's edge, each reading a small label over its number, no charts. Numbers are set in Bahnschrift, the DIN face Windows ships. -->
<Window x:Class="Mazesta.Desktop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
        xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
        xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
        Title="Mazesta Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Focusable="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="Ov.Font">Bahnschrift SemiCondensed, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Ov.FontWide">Bahnschrift, Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="Ov.Label" Color="#FFC3C7CC" />
        <SolidColorBrush x:Key="Ov.Faint" Color="#FF8A9097" />
        <SolidColorBrush x:Key="Ov.Game" Color="#FFFDD400" />
        <SolidColorBrush x:Key="Ov.GameEdge" Color="#59FDD400" />
        <SolidColorBrush x:Key="Ov.GameTint" Color="#14FDD400" />
        <Style x:Key="Ov.Num" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ov.Font}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="Ov.Tag" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ov.FontWide}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ov.Faint}" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <!-- A part's title: its short name, bold, on a solid tag of its colour. -->
        <DataTemplate x:Key="Ov.Title" DataType="{x:Type vm:OverlaySection}">
            <Border Background="{Binding Hue}" CornerRadius="3" Padding="6,2,6,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Ov.Tag}" FontSize="11" FontWeight="Black" Foreground="#FF0E1012" />
            </Border>
        </DataTemplate>
        <!-- One session number of the frame rate (average, lowest, highest): a bold tag over the number. -->
        <Style x:Key="Ov.Stat" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Visibility" Value="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}" />
        </Style>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="9" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="8">
        <Border.Background><SolidColorBrush Color="#0E1012" Opacity="{Binding Opacity}" /></Border.Background>
        <Grid>
            <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" /></Grid.LayoutTransform>

            <!-- ——— Stacked: one column or two ——— -->
            <StackPanel Width="{Binding PanelWidth}" Visibility="{Binding IsStacked, Converter={StaticResource BoolToVis}}">
                <!-- The mark, and the program the frame rate is measured in. -->
                <DockPanel Margin="4,1,4,7">
                    <Border DockPanel.Dock="Left" Width="3" Height="10" Background="{StaticResource Ov.Game}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="MAZESTA" Style="{StaticResource Ov.Tag}" Foreground="#FFA4A8AD" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeroApp}" FontFamily="{StaticResource Ov.Font}" FontSize="10" Foreground="{StaticResource Ov.Faint}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" FlowDirection="LeftToRight" />
                </DockPanel>

                <!-- The frame-rate box. -->
                <Border Margin="0,0,0,8" CornerRadius="6" BorderBrush="{StaticResource Ov.GameEdge}" Background="{StaticResource Ov.GameTint}" BorderThickness="1" Padding="10,7,10,9"
                        Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2" LastChildFill="False">
                            <Border DockPanel.Dock="Left" Background="{StaticResource Ov.Game}" CornerRadius="3" Padding="6,2,6,1" VerticalAlignment="Center">
                                <TextBlock Text="GAME" Style="{StaticResource Ov.Tag}" FontSize="11" FontWeight="Black" Foreground="#FF0E1012" />
                            </Border>
                        </DockPanel>
                        <Grid FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" DataContext="{Binding HeroFps}"
                                        Visibility="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}">
                                <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="44" FontWeight="Bold" LineHeight="40" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Text="FPS" Style="{StaticResource Ov.Tag}" FontSize="10.5" Foreground="{StaticResource Ov.Game}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding HeroLow}" Visibility="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}">
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="1% LOW" Style="{StaticResource Ov.Tag}" Width="40" Margin="5,0,0,3" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding HeroFrameTime}" Visibility="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}">
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="MS" Style="{StaticResource Ov.Tag}" Width="40" Margin="5,0,0,3" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <!-- The session: average, lowest and highest since this program came to the front. -->
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,7,0,0" Visibility="{Binding HasSessionStats, Converter={StaticResource BoolToVis}}">
                            <StackPanel DataContext="{Binding HeroAvg}" Style="{StaticResource Ov.Stat}">
                                <TextBlock Text="AVG" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                                <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="17" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel DataContext="{Binding HeroMin}" Style="{StaticResource Ov.Stat}">
                                <TextBlock Text="MIN" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                                <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="17" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel DataContext="{Binding HeroMax}" Style="{StaticResource Ov.Stat}">
                                <TextBlock Text="MAX" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                                <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="17" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>
                        <controls:FrameChart Values="{Binding HeroTrend}" Level="{Binding HeroLowValue}" Stroke="{StaticResource Ov.Game}" Capacity="{x:Static vm:OverlayViewModel.TrendLength}"
                                             Height="72" Margin="0,8,0,0" Visibility="{Binding HeroFps, Converter={x:Static controls:NullToCollapsed.Instance}}" />
                    </StackPanel>
                </Border>

                <!-- A box per part; they wrap at the panel's width: one per line, or two side by side. -->
                <ItemsControl ItemsSource="{Binding Blocks}" Margin="-4,-4,-4,-4">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OverlaySection}">
                            <Border Width="{Binding DataContext.SectionWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="4"
                                    CornerRadius="6" BorderBrush="{Binding HueEdge}" Background="{Binding HueTint}" BorderThickness="1" Padding="9,7,9,7">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Ov.Title}" />
                                        <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource Ov.Font}" FontSize="9.5" Foreground="{StaticResource Ov.Faint}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" FlowDirection="LeftToRight" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OverlayRow}">
                                                <StackPanel Margin="0,3,0,2">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ov.Label}" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15.5" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding UnitText}" Style="{StaticResource Ov.Num}" FontSize="9" FontWeight="Bold" Foreground="{Binding Hue}" Margin="3,0,0,2" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <!-- A share of a fixed top: a thin scale that fills from the start edge. -->
                                                    <Grid Height="2" Margin="0,4,0,0" FlowDirection="LeftToRight" Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}">
                                                        <Border Background="#1AFFFFFF" />
                                                        <Border Background="{Binding Hue}" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}" /></Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                    <Border Height="26" Margin="0,4,0,1" Background="#4D000000" CornerRadius="2" Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <controls:Sparkline Values="{Binding Trend}" Maximum="{Binding TrendMax}" Capacity="{x:Static vm:OverlayViewModel.TrendLength}" Stroke="{Binding Hue}" />
                                                            <StackPanel Orientation="Horizontal" Margin="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" TextElement.FontSize="8" TextElement.Foreground="#AAFFFFFF">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Style.Triggers><DataTrigger Binding="{Binding TrendMaxValue}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="{loc:Loc Overlay_ChartMaxWord}" Margin="0,0,3,0" />
                                                                <TextBlock Text="{Binding TrendMaxValue}" FontFamily="{StaticResource Ov.Font}" FlowDirection="LeftToRight" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ——— Line: one strip of boxes side by side, each reading a label over its number ——— -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLine, Converter={StaticResource BoolToVis}}">
                <Border Width="3" Background="{StaticResource Ov.Game}" Margin="2,4,6,4" />
                <Border Margin="0,0,6,0" CornerRadius="6" BorderBrush="{StaticResource Ov.GameEdge}" Background="{StaticResource Ov.GameTint}" BorderThickness="1" Padding="9,5,9,5"
                        Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding HeroFps}" Visibility="{Binding Converter={x:Static controls:NullToCollapsed.Instance}}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="FPS" Style="{StaticResource Ov.Tag}" FontSize="10" Foreground="{StaticResource Ov.Game}" Margin="4,0,0,4" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding HeroLow}" Style="{StaticResource Ov.Stat}" VerticalAlignment="Center">
                            <TextBlock Text="1% LOW" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding HeroAvg}" Style="{StaticResource Ov.Stat}" VerticalAlignment="Center">
                            <TextBlock Text="AVG" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding HeroMin}" Style="{StaticResource Ov.Stat}" VerticalAlignment="Center">
                            <TextBlock Text="MIN" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding HeroMax}" Style="{StaticResource Ov.Stat}" VerticalAlignment="Center">
                            <TextBlock Text="MAX" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding HeroFrameTime}" Style="{StaticResource Ov.Stat}" Margin="0" VerticalAlignment="Center">
                            <TextBlock Text="MS" Style="{StaticResource Ov.Tag}" Foreground="{StaticResource Ov.Game}" />
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OverlaySection}">
                            <Border Margin="0,0,6,0" CornerRadius="6" BorderBrush="{Binding HueEdge}" Background="{Binding HueTint}" BorderThickness="1" Padding="8,5,9,5">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Ov.Title}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OverlayRow}">
                                                <StackPanel Margin="0,0,11,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Ov.Faint}" />
                                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Number}" Style="{StaticResource Ov.Num}" FontSize="15" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding UnitText}" Style="{StaticResource Ov.Num}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding Hue}" Margin="2,0,0,2" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</Window>

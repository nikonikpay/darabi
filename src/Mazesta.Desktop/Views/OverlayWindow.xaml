<!-- The on-screen overlay: a small translucent panel in a corner of the screen, always on top, that the mouse passes through (see the code-behind).
     A block per part in that part's colour; a charted item draws its last minute right under its own label, with the chart's top written on it. -->
<Window x:Class="Mazesta.Desktop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
        xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
        Title="Mazesta Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Focusable="False">
    <Border x:Name="Root" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,9,12,6">
        <Border.Background><SolidColorBrush Color="#0B0B0D" Opacity="{Binding Opacity}" /></Border.Background>
        <StackPanel Width="{Binding PanelWidth}">
            <StackPanel.LayoutTransform><ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" /></StackPanel.LayoutTransform>
            <DockPanel Margin="0,0,0,4">
                <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Brush.Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="MAZESTA" FontFamily="{StaticResource App.Font.Latin}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Sections}">
                <!-- Blocks wrap at the panel's width: one per line in the list layout, two side by side in the columns layout. -->
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlaySection}">
                        <StackPanel Width="{Binding DataContext.SectionWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <StackPanel.Margin><Binding Path="DataContext.SectionMargin" RelativeSource="{RelativeSource AncestorType=ItemsControl}" /></StackPanel.Margin>
                            <DockPanel Margin="0,0,0,2">
                                <Border DockPanel.Dock="Left" Width="3" Height="11" CornerRadius="1.5" Background="{Binding Hue}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontFamily="{StaticResource App.Font.Latin}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Hue}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource App.Font.Latin}" FontSize="9.5" Foreground="#FF8F8C82" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,0,0" FlowDirection="LeftToRight" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OverlayRow}">
                                        <StackPanel Margin="0,0.5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="10.5" Foreground="#FFB9B9C2" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Value}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border Height="24" Margin="0,2,0,4" Background="#0EFFFFFF" CornerRadius="3" Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <controls:Sparkline Values="{Binding Trend}" Maximum="{Binding TrendMax}" Capacity="{x:Static vm:OverlayViewModel.TrendLength}" Stroke="{Binding Hue}" />
                                                    <TextBlock Text="{Binding TrendCaption}" FontFamily="{StaticResource App.Font.Latin}" FontSize="8.5" Foreground="#AAFFFFFF" Margin="4,1"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" FlowDirection="LeftToRight" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>

<UserControl x:Class="Mazesta.Desktop.Views.TestCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
             xmlns:vm="clr-namespace:Mazesta.Desktop.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource Brush.Background}" Style="{StaticResource View.FadeIn}">
    <UserControl.Resources>
        <controls:RepeatModeToLabelConverter x:Key="RepeatModeToLabelConverter" />
        <Style x:Key="RowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Nav_Tests}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- A checkpoint left over from a crash is surfaced honestly: not resumed silently, not hidden. -->
        <Border Grid.Row="1" Style="{StaticResource RowBorderStyle}" BorderBrush="{StaticResource Brush.Accent}"
                Visibility="{Binding HasIncompleteSession, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding IncompleteSessionMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{loc:Loc Test_IncompleteSession_Dismiss}"
                        Command="{Binding DismissIncompleteSessionCommand}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="56" Style="{StaticResource TextBox.Value}" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{loc:Loc Test_Seconds}" Margin="6,0,0,0" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding Repeat}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource RepeatModeToLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBox Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource TextBox.Value}"
                                             Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsRepeatCount, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="10,0">
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding PercentComplete, Mode=OneWay}" Height="6" FlowDirection="LeftToRight" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OutcomeText}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ErrorsText}" Style="{StaticResource Text.Value}" Foreground="{StaticResource Brush.TextMuted}"
                                                   FontSize="11" HorizontalAlignment="Right"
                                                   Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Options}" Margin="30,2,0,0"
                                              Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TestOptionViewModel}">
                                            <StackPanel Orientation="Horizontal" Margin="0,6,18,0">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Label" MinWidth="200" VerticalAlignment="Center"
                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinWidth="110" Style="{StaticResource TextBox.Value}" VerticalAlignment="Center"
                                                         Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource Brush.Accent}" Margin="0,8,0,0"
                                           Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Value}" Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Left"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{loc:Loc Test_Start}" Command="{Binding StartCommand}" Padding="14,6" />
            <Button Content="{loc:Loc Test_Cancel}" Command="{Binding CancelCommand}" Padding="14,6" Margin="10,0,0,0" />
            <Button Content="{loc:Loc Test_SelectAll}" Command="{Binding SelectAllCommand}" Padding="14,6" Margin="24,0,0,0" />
            <Button Content="{loc:Loc Test_ClearSelection}" Command="{Binding ClearSelectionCommand}" Padding="14,6" Margin="10,0,0,0" />
            <controls:HelpTip HelpKey="Test_Center" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>

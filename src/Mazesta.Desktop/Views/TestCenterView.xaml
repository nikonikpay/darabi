<UserControl x:Class="Mazesta.Desktop.Views.TestCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Mazesta.Desktop.Localization"
             xmlns:controls="clr-namespace:Mazesta.Desktop.Controls"
             xmlns:diag="clr-namespace:Mazesta.Diagnostics;assembly=Mazesta.Diagnostics"
             mc:Ignorable="d"
             Background="{StaticResource Brush.Background}">
    <UserControl.Resources>
        <controls:RepeatModeToLabelConverter x:Key="RepeatModeToLabelConverter" />
        <Style x:Key="RowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Nav_Tests}" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource Brush.Text}" Margin="0,0,0,12" />

        <!-- Spec §8/§2.5: a checkpoint left over from a crash is surfaced honestly, not resumed
             silently and not hidden. -->
        <Border Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource RowBorderStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IncompleteSessionMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding IncompleteSessionMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{loc:Loc Test_IncompleteSession_Dismiss}"
                        Command="{Binding DismissIncompleteSessionCommand}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                        <TextBox Width="56" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{loc:Loc Test_Seconds}" Margin="6,0,0,0" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"
                                              Style="{StaticResource {x:Type ComboBox}}"
                                              ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding Repeat}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource RepeatModeToLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBox Grid.Column="4" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                             Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Repeat}" Value="{x:Static diag:RepeatMode.Count}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="10,0">
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding PercentComplete, Mode=OneWay}" Height="6" FlowDirection="LeftToRight" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OutcomeText}" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Right" />
                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="11" HorizontalAlignment="Right" FlowDirection="LeftToRight">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <Binding Path="ErrorCount" StringFormat="{}{0} errors" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource Brush.Accent}" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,6,0,0"
                                           TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{loc:Loc Test_Start}" Command="{Binding StartCommand}" Padding="14,6" />
            <Button Content="{loc:Loc Test_Cancel}" Command="{Binding CancelCommand}" Padding="14,6" Margin="10,0,0,0" />
            <controls:HelpTip HelpKey="Test_Center" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>

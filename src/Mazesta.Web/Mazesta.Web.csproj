<Project Sdk="Microsoft.NET.Sdk">
  <!-- The web edition: the same core, engines and view models as Mazesta.Desktop (referenced as a library), with the whole interface drawn by
       one WebView2 from the local wwwroot folder. Nothing is fetched from the internet; the WPF edition is not changed by it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MazestaWeb</AssemblyName>
    <RootNamespace>Mazesta.Web</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <ApplicationIcon>..\Mazesta.Desktop\Assets\mazesta.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mazesta.Desktop/Mazesta.Desktop.csproj" />
    <!-- The tray monitor ships next to this exe too (Settings starts and registers it, and it opens this app). Not referenced as code. -->
    <ProjectReference Include="../Mazesta.Tray/Mazesta.Tray.csproj" ReferenceOutputAssembly="false" OutputItemType="TrayOutput" />
  </ItemGroup>
  <ItemGroup>
    <!-- The report writer embeds the app font from pack://application:,,,/Fonts/, which resolves against this executable. -->
    <Resource Include="..\Mazesta.Desktop\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
    <Resource Include="..\Mazesta.Desktop\Assets\mazesta.ico" Link="Assets\mazesta.ico" />
    <!-- The demo files let the page be opened in a plain browser for design work; the app never loads them and they are not shipped. -->
    <Content Include="wwwroot\**\*" Exclude="wwwroot\js\demo*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- As in Mazesta.Desktop: @(TrayOutput) is the tray's dll; the build copies it with its apphost, deps and runtimeconfig, and publishing adds the
       dll the SDK leaves out for a non-referenced project. Without the dll the tray exe starts and dies at once. -->
  <Target Name="BundleTray" AfterTargets="Build" Condition="'@(TrayOutput)' != ''">
    <ItemGroup>
      <TrayFile Include="@(TrayOutput)" />
      <TrayFile Include="@(TrayOutput->'%(RootDir)%(Directory)MazestaTray.exe');@(TrayOutput->'%(RootDir)%(Directory)MazestaTray.runtimeconfig.json');@(TrayOutput->'%(RootDir)%(Directory)MazestaTray.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(TrayFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishTrayDll" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup><ResolvedFileToPublish Include="@(TrayOutput)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  </Target>
</Project>

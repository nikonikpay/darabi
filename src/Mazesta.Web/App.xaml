<Application x:Class="Mazesta.Web.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- The WPF pieces the web edition still shows (the PDF printer's busy window, the overlay) use the WPF edition's theme. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MazestaTest;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MazestaTest;component/Themes/SensorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

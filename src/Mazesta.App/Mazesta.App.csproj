<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app: the core, engines and view models of the app layer (Mazesta.Desktop, referenced as a library), with the whole interface drawn by
       one WebView2 from the local wwwroot folder. The page loads nothing from the internet (the host fetches the shop product for it). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The window, the pop-out charts and the notification icon are Windows Forms (WPF was removed on 2026-10-01); its global usings are
         removed so its names (Timer, Label, Screen...) never shadow the app's own: each file names what it uses. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The users' app is Mazesta.exe; Mazesta's own edition is Mazesta-Admin.exe. -->
    <AssemblyName>Mazesta</AssemblyName>
    <AssemblyName Condition="'$(MazestaEdition)' != 'Client'">Mazesta-Admin</AssemblyName>
    <RootNamespace>Mazesta.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <ApplicationIcon>..\Mazesta.Desktop\Assets\mazesta.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Two editions of one app: Mazesta's own (the default: the service number, the link to the site, the reference marks) and the users'
       (-p:MazestaEdition=Client), which has none of those. tools/publish.ps1 builds both. -->
  <PropertyGroup Condition="'$(MazestaEdition)' == 'Client'">
    <DefineConstants>$(DefineConstants);MAZESTA_CLIENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mazesta.Desktop/Mazesta.Desktop.csproj" />
    <!-- The tray monitor ships next to this exe too (Settings starts and registers it, and it opens this app). Not referenced as code. -->
    <ProjectReference Include="../Mazesta.Tray/Mazesta.Tray.csproj" ReferenceOutputAssembly="false" OutputItemType="TrayOutput" />
  </ItemGroup>
  <ItemGroup>
    <!-- The demo files let the page be opened in a plain browser for design work; the app never loads them and they are not shipped. -->
    <Content Include="wwwroot\**\*" Exclude="wwwroot\js\demo*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- As in Mazesta.Desktop: @(TrayOutput) is the tray's dll; the build copies it with its apphost, deps and runtimeconfig, and publishing adds the
       dll the SDK leaves out for a non-referenced project. Without the dll the tray exe starts and dies at once. -->
  <Target Name="BundleTray" AfterTargets="Build" Condition="'@(TrayOutput)' != ''">
    <ItemGroup>
      <TrayFile Include="@(TrayOutput)" />
      <TrayFile Include="@(TrayOutput->'%(RootDir)%(Directory)MazestaTray.exe');@(TrayOutput->'%(RootDir)%(Directory)MazestaTray.runtimeconfig.json');@(TrayOutput->'%(RootDir)%(Directory)MazestaTray.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(TrayFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishTrayDll" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup><ResolvedFileToPublish Include="@(TrayOutput)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- The GPU tests run compute shaders through DirectX 12 (ComputeSharp), which is Windows-only, so they live in
       their own project instead of putting that dependency on Diagnostics. Deliberately NOT net10.0-windows10.0.17763.0: that
       platform version pulls in the 23 MB WinRT projection for no benefit; ComputeSharp restores fine on net10.0-windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mazesta.Core/Mazesta.Core.csproj" />
    <ProjectReference Include="../Mazesta.Monitoring/Mazesta.Monitoring.csproj" />
    <ProjectReference Include="../Mazesta.Diagnostics/Mazesta.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mazesta.Diagnostics.Gpu.Tests" />
  </ItemGroup>
</Project>

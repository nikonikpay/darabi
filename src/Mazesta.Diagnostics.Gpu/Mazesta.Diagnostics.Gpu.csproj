<Project Sdk="Microsoft.NET.Sdk">
  <!-- The GPU tests run compute shaders through DirectX 12 (ComputeSharp), which is Windows-only, so they live in
       their own project instead of putting that dependency on Diagnostics. Deliberately NOT net10.0-windows10.0.17763.0: that
       platform version pulls in the 23 MB WinRT projection for no benefit; ComputeSharp restores fine on net10.0-windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp" />
    <PackageReference Include="Vortice.Direct3D12" />
    <!-- build: the package's props copy its own 18 MB DirectML.dll next to the app; Windows' System32 copy is used instead. -->
    <PackageReference Include="Vortice.DirectML" ExcludeAssets="build;buildMultitargeting;native" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mazesta.Core/Mazesta.Core.csproj" />
    <ProjectReference Include="../Mazesta.Monitoring/Mazesta.Monitoring.csproj" />
    <ProjectReference Include="../Mazesta.Diagnostics/Mazesta.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Raw D3D12 shaders, precompiled to DXIL by tools/compile-gpu-shaders.ps1 (the build does not need the Windows SDK). -->
    <EmbeddedResource Include="Shaders/*.cso" LogicalName="Mazesta.Diagnostics.Gpu.Shaders.%(Filename).cso" />
    <!-- The Persian garden the visual tests draw, written by tools/scene/export_garden.py from Mazesta-Art/courtyard-v10.blend. -->
    <EmbeddedResource Include="Scene/garden.mzscene" LogicalName="Mazesta.Diagnostics.Gpu.Scene.garden.mzscene" />
    <!-- The light bounced round that garden, worked out for the Direct3D test by the ray tracer (Scene/GardenLightVolume.cs). -->
    <EmbeddedResource Include="Scene/garden.light" LogicalName="Mazesta.Diagnostics.Gpu.Scene.garden.light" Condition="Exists('Scene/garden.light')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mazesta.Diagnostics.Gpu.Tests" />
  </ItemGroup>
</Project>

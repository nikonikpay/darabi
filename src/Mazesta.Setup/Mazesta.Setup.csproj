<Project Sdk="Microsoft.NET.Sdk">
  <!-- The users' installer (MazestaTestSetup.exe): one exe that carries the users' edition as a zip (-p:PayloadZip=<file>, made by
       tools/publish.ps1 from artifacts\Mazesta-Client) and puts it on the computer like any other program: a folder of the user's choice (by default
       Program Files, for every user of the computer, so it asks for administrator rights once), the common Start menu and desktop shortcuts, and an entry in Installed apps (HKLM) that runs
       "Mazesta.exe" with the uninstall argument. Installing over an installed copy replaces its files and keeps its Data.
       It runs on the .NET Framework that is part of Windows 10 and 11 (4.7.2 and later), not on a runtime of its own: a self-contained exe
       carried some 46 MB of .NET beside the app, so the installer was that much larger than the zip of what it installs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MazestaTestSetup</AssemblyName>
    <RootNamespace>Mazesta.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Mazesta.Desktop\Assets\mazesta.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
    <Using Remove="System.Net.Http" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>

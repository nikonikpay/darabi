<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shop's release tool (never shipped): builds the update folder for the site - the app's zip, the benchmark comparison lists made from the
       shop's run logs, and the signed update.json. See docs/UPDATES.md; tools/release.ps1 runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>mazesta-release</AssemblyName>
    <RootNamespace>Mazesta.Release</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Mazesta.Diagnostics/Mazesta.Diagnostics.csproj" />
  </ItemGroup>
</Project>

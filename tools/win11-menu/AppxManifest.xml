<?xml version="1.0" encoding="utf-8"?>
<!-- A sparse package: it gives MazestaShell.dll (in the app's own folder, the "external location") an identity so Windows 11 shows the file tools in the top-level right-click menu. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10/4"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="Mazesta.FileMenu" Publisher="CN=Mazesta Test" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Mazesta file menu</DisplayName>
    <PublisherDisplayName>Mazesta</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources><Resource Language="en-us" /></Resources>
  <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" /></Dependencies>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
  <Applications>
    <Application Id="App" Executable="MazestaTray.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="Mazesta file menu" Description="Mazesta file tools in the right-click menu" BackgroundColor="transparent" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\Logo.png" />
      <Extensions>
    <desktop4:Extension Category="windows.fileExplorerContextMenus">
      <desktop4:FileExplorerContextMenus>
        <desktop5:ItemType Type="Directory"><desktop5:Verb Id="MazestaLocks" Clsid="7b1e4c52-3a1d-4f0e-9a51-6d2c0f5a1a01" /></desktop5:ItemType>
        <desktop5:ItemType Type="*">
          <desktop5:Verb Id="MazestaLocks" Clsid="7b1e4c52-3a1d-4f0e-9a51-6d2c0f5a1a01" />
          <desktop5:Verb Id="MazestaResize" Clsid="7b1e4c52-3a1d-4f0e-9a51-6d2c0f5a1a02" />
          <desktop5:Verb Id="MazestaRename" Clsid="7b1e4c52-3a1d-4f0e-9a51-6d2c0f5a1a03" />
        </desktop5:ItemType>
      </desktop4:FileExplorerContextMenus>
    </desktop4:Extension>
    <com:Extension Category="windows.comServer">
      <com:ComServer>
        <com:SurrogateServer DisplayName="Mazesta file menu">
          <com:Class Id="7b1e4c52-3a1d-4f0e-9a51-6d2c0f5a1a01" Path="ShellMenu\MazestaShell.dll" ThreadingModel="STA" />
          <com:Class Id="7b1e4c52-3a1d-4f0e-9a51-6d2c0f5a1a02" Path="ShellMenu\MazestaShell.dll" ThreadingModel="STA" />
          <com:Class Id="7b1e4c52-3a1d-4f0e-9a51-6d2c0f5a1a03" Path="ShellMenu\MazestaShell.dll" ThreadingModel="STA" />
        </com:SurrogateServer>
      </com:ComServer>
    </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
